{
	"name": "n8n-nodes-bkash",
	"version": "0.1.0",
	"description": "Unofficial n8n community node for the bKash Payment Gateway (Tokenized Checkout API)",
	"license": "MIT",
	"homepage": "https://github.com/hasibulrag/n8n-nodes-bkash#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"bkash",
		"payment-gateway",
		"bangladesh",
		"tokenized-checkout"
	],
	"author": {
		"name": "hasibulislamai",
		"email": "hasibulrag@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hasibulrag/n8n-nodes-bkash.git"
	},
	"bugs": {
		"url": "https://github.com/hasibulrag/n8n-nodes-bkash/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BkashApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Bkash/Bkash.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.57.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
